# 复制为 .env，再填写自己的配置；请勿提交真实密钥。
RAG_MODE=preview
RAG_API_KEY=
RAG_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_CHAT_MODEL=qwen-plus
RAG_EMBED_MODEL=text-embedding-v4
RAG_ENABLE_THINKING=false
RAG_PORT=8791
RAG_MIN_SIMILARITY=0.35
# 默认实例可先用 localhost；命名实例按本机实际情况填写。
RAG_SQL_SERVER=localhost
RAG_SQL_DATABASE=Inventory
RAG_SQLCMD_PATH=C:\Program Files\Microsoft SQL Server\Client SDK\ODBC\170\Tools\Binn\SQLCMD.EXE
